---
// src/components/Hero.astro
const titulo = "Resalta tu belleza natural";
const subtitulo = "Especialista en cuidado facial, limpiezas profundas y tratamientos personalizados para que tu piel luzca radiante y saludable.";
---

<section class="relative w-full h-[70vh] flex items-center justify-center overflow-hidden bg-[#2d3a24]">
  
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_#556b2f,_transparent_70%)] opacity-60"></div>
  
  <div class="relative max-w-3xl mx-auto px-6 text-center">
    <h1 class="text-4xl md:text-6xl font-light tracking-wide text-white leading-tight">
      {titulo} 
      <span class="block mt-2 font-serif italic text-amber-300">
        Cuidado Profesional
      </span>
    </h1>
    
    <p class="mt-8 text-base md:text-lg text-stone-200 leading-relaxed max-w-2xl mx-auto font-light">
      {subtitulo}
    </p>

    <div class="mt-12 flex flex-col sm:flex-row gap-4 justify-center items-center">
      <a href="#servicios" class="px-8 py-4 bg-white text-[#2d3a24] hover:bg-stone-100 font-medium tracking-wider text-sm uppercase rounded-full shadow-lg transition-all duration-300">
        Ver Servicios
      </a>
      <a href="#agenda" class="px-8 py-4 bg-transparent hover:bg-white/10 text-white border border-white/30 font-semibold tracking-wider text-sm uppercase rounded-full transition-all duration-300">
        Agendar Cita
      </a>
    </div>
  </div>
</section>