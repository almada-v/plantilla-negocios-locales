            <div class="absolute z-10 animate-magic-sparkle" style="top: 43%; left: 10%; animation-delay: 0.9s;"><svg viewBox="0 0 68 68" height="10" width="10"><path fill="currentColor" d="M26.5 25.5C19.0043 33.3697 0 34 0 34C0 34 19.1013 35.3684 26.5 43.5C33.234 50.901 34 68 34 68C34 68 36.9884 50.7065 44.5 43.5C51.6431 36.647 68 34 68 34C68 34 51.6947 32.0939 44.5 25.5C36.5605 18.2235 34 0 34 0C34 0 33.6591 17.9837 26.5 25.5Z"></path></svg></div>
