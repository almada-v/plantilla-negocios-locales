---
import { Image } from 'astro:assets';
import fondoImagen from '../assets/FONDO1.avif'; 

const linkWhatsApp = `https://wa.me/523151195149?text=${encodeURIComponent("¡Hola! Me gustaría agendar una consulta.")}`;
---

<section class="relative w-full min-h-[90svh] flex flex-col lg:flex-row bg-[#fdfdfc] overflow-hidden">
  
  <div class="relative w-full h-[45svh] lg:h-full lg:w-[60%] z-10 shrink-0">
    <Image 
      src={fondoImagen} 
      alt="Cosmética facial" 
      class="w-full h-full object-cover"
      quality="high"
      format="webp"
    />
    <div class="absolute inset-0 bg-gradient-to-t lg:bg-gradient-to-r from-[#fdfdfc] via-transparent to-transparent"></div>
  </div>

  <div class="relative w-full lg:flex-1 flex flex-col justify-center px-8 py-12 lg:px-20 z-20 bg-[#fdfdfc] items-center lg:items-start text-center lg:text-left">
    <div class="animate-enter-up space-y-6 max-w-lg mx-auto lg:mx-0">
      <span class="inline-block text-[10px] font-bold tracking-[0.3em] uppercase text-[#556b2f]">
        TRATAMIENTOS FACIALES A LA MEDIDA
      </span>

      <h1 class="text-4xl md:text-6xl lg:text-7xl font-serif text-stone-900 leading-[0.95] tracking-tight">
        Resultados <br />
        <span class="italic text-[#556b2f]">que se notan.</span>
      </h1>

      <p class="text-stone-600 text-lg leading-relaxed">
        Elevamos el cuidado de tu piel a un nivel de experiencia premium con tratamientos personalizados.
      </p>

      <div class="pt-4 w-full flex justify-center lg:justify-start">
        <a href={linkWhatsApp} target="_blank" class="relative inline-block w-full max-w-[300px]">
          <button class="flex items-center justify-center bg-[#556b2f] text-sm text-white font-medium rounded-xl transition-all px-6 py-4 w-full active:scale-95 shadow-lg shadow-[#556b2f]/20" type="button">
            Agendar Consulta
          </button>
          
          <div class="absolute inset-0 pointer-events-none text-white">
            <div class="absolute z-10 animate-magic-sparkle" style="top: -15%; left: 95%; animation-delay: 0.5s;"><svg viewBox="0 0 68 68" height="10" width="10"><path fill="currentColor" d="M26.5 25.5C19.0043 33.3697 0 34 0 34C0 34 19.1013 35.3684 26.5 43.5C33.234 50.901 34 68 34 68C34 68 36.9884 50.7065 44.5 43.5C51.6431 36.647 68 34 68 34C68 34 51.6947 32.0939 44.5 25.5C36.5605 18.2235 34 0 34 0C34 0 33.6591 17.9837 26.5 25.5Z"></path></svg></div>
            <div class="absolute z-10 animate-magic-sparkle" style="top: 7%; left: -5%; animation-delay: 0.33s;"><svg viewBox="0 0 68 68" height="13" width="13"><path fill="currentColor" d="M26.5 25.5C19.0043 33.3697 0 34 0 34C0 34 19.1013 35.3684 26.5 43.5C33.234 50.901 34 68 34 68C34 68 36.9884 50.7065 44.5 43.5C51.6431 36.647 68 34 68 34C68 34 51.6947 32.0939 44.5 25.5C36.5605 18.2235 34 0 34 0C34 0 33.6591 17.9837 26.5 25.5Z"></path></svg></div>
