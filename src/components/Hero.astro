---
// src/components/Hero.astro
const titulo = "Resalta tu belleza natural";
const subtitulo = "Especialista en cuidado facial, limpiezas profundas y tratamientos personalizados para que tu piel luzca radiante y saludable.";
---

<section class="relative w-full max-w-5xl mx-auto px-6 pt-20 pb-16 text-center md:pt-32 md:pb-24">
  
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-72 h-72 bg-cyan-500/10 rounded-full blur-3xl -z-10"></div>

  <div class="max-w-3xl mx-auto">
    <h1 class="text-4xl md:text-6xl font-black tracking-tight text-white leading-tight">
      {titulo} 
      <span class="block mt-2 bg-gradient-to-r from-cyan-400 to-blue-500 bg-clip-text text-transparent">
        Cuidado Profesional
      </span>
    </h1>
    
    <p class="mt-6 text-lg md:text-xl text-slate-400 leading-relaxed max-w-2xl mx-auto">
      {subtitulo}
    </p>

    <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center items-center">
      <a 
        href="#servicios" 
        class="w-full sm:w-auto px-8 py-4 bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-600 hover:to-blue-700 text-white font-bold rounded-2xl shadow-xl shadow-cyan-500/10 hover:scale-105 active:scale-98 transition-all duration-300 text-center"
      >
        Ver Servicios
      </a>
      <a 
        href="#contacto" 
        class="w-full sm:w-auto px-8 py-4 bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold rounded-2xl border border-slate-700 hover:border-slate-600 transition-all duration-300 text-center"
      >
        Agendar Cita
      </a>
    </div>
  </div>

</section>