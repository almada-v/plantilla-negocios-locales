---
// src/components/Servicios.astro
const titulo = "Nuestros Servicios";
const subtitulo = "Elige el servicio ideal para ti";
const tratamientos = [
  {
    nombre: "Limpieza Facial Profunda",
    precio: "$1,200 MXN",
    foto: "https://images.unsplash.com/photo-1512290923902-8a9f81dc236c?q=80&w=600&auto=format&fit=crop",
    desc: "Un tratamiento exhaustivo para eliminar impurezas y células muertas, dejando tu piel renovada.",
    beneficios: ["Eliminación profunda de puntos negros", "Hidratación equilibrada", "Mejora la textura"],
    calendlyLink: "https://calendar.app.google/vJ58zUGu1VzDXrE88"
  },
  {
    nombre: "Microdermoabrasión",
    precio: "$1,500 MXN",
    foto: "https://images.unsplash.com/photo-1560750588-73207b1ef5b8?q=80&w=600&auto=format&fit=crop",
    desc: "Técnica de exfoliación mecánica que estimula la producción de colágeno y rejuvenece.",
    beneficios: ["Reduce líneas de expresión", "Atenúa manchas solares", "Efecto piel de porcelana"],
    calendlyLink: "https://calendly.com/tu-usuario/microdermoabrasion"
  },
  {
    nombre: "Peeling Químico",
    precio: "$1,800 MXN",
    foto: "https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?q=80&w=600&auto=format&fit=crop",
    desc: "Renovación celular profunda mediante activos químicos profesionales.",
    beneficios: ["Elimina células muertas", "Control de acné", "Unifica el tono"],
    calendlyLink: "https://calendly.com/tu-usuario/peeling"
  }
];
---

<section id="servicios" class="py-24 bg-stone-50">
  <div class="max-w-6xl mx-auto px-4">
    
    <div class="relative max-w-3xl mx-auto px-6 text-center">
    <h1 class="text-4xl md:text-6xl font-serif  tracking-wide text-[#556b2f] leading-tight">
      {titulo} 
    </h1>
    <br>
    </div>

    <div class="relative group">
      <div id="carousel" class="flex overflow-x-auto gap-6 pb-8 snap-x snap-mandatory scroll-smooth scrollbar-hide">
        {tratamientos.map((item, i) => (
          <div class="min-w-[85%] sm:min-w-[45%] md:min-w-[30%] flex flex-col rounded-3xl border border-stone-200 bg-white overflow-hidden shadow-sm snap-start">
            <img src={item.foto} alt={item.nombre} class="w-full h-48 object-cover" />
            <div class="p-6 flex flex-col flex-grow">
              <h3 class="text-lg font-medium text-stone-800 mb-2">{item.nombre}</h3>
              <p class="text-xl font-light text-[#556b2f] mb-6">{item.precio}</p>
              <button onclick={`openModal(${i})`} class="mt-auto w-full py-3 bg-[#556b2f] text-white rounded-full text-xs font-semibold uppercase tracking-wider hover:bg-[#3b4d1f] transition-all">
                Ver detalles
              </button>
            </div>
          </div>
        ))}
      </div>
      
      <button id="prev" class="hidden md:flex absolute -left-12 top-1/3 p-3 bg-white border rounded-full shadow-lg hover:bg-stone-50 z-20 transition-all">←</button>
      <button id="next" class="hidden md:flex absolute -right-12 top-1/3 p-3 bg-white border rounded-full shadow-lg hover:bg-stone-50 z-20 transition-all">→</button>
    </div>
  </div>
</section>

<div id="modal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4">
  <div class="absolute inset-0 bg-stone-900/40 backdrop-blur-sm" onclick="closeModal()"></div>
  <div class="bg-white w-full max-w-lg rounded-3xl overflow-hidden relative shadow-2xl">
    <button onclick="closeModal()" class="absolute top-4 right-4 bg-white/80 p-2 rounded-full z-10">✕</button>
    
    <div id="modal-info-view">
      <img id="modal-foto" src="" class="w-full h-56 object-cover" />
      <div class="p-8">
        <h3 id="modal-titulo" class="text-2xl font-light text-stone-900 mb-2"></h3>
        <p id="modal-desc" class="text-stone-500 mb-6 text-sm"></p>
        <ul id="modal-beneficios" class="space-y-2 mb-8 text-sm text-stone-700"></ul>
        <div class="flex items-center justify-between pt-6 border-t">
          <span id="modal-precio" class="text-lg font-semibold text-[#556b2f]"></span>
          <button id="btn-agendar-inicio" class="bg-[#556b2f] text-white px-6 py-3 rounded-full text-sm font-semibold hover:bg-[#3b4d1f]">Agendar ahora</button>
        </div>
      </div>
    </div>

    <div id="modal-calendar-view" class="hidden p-8">
      <div id="calendly-embed" class="w-full h-[400px]"></div>
      <div class="flex justify-center mt-6">
        <button onclick="resetModal()" class="py-3 px-8 bg-[#556b2f] text-white rounded-full text-sm font-semibold hover:bg-[#3b4d1f]">← Volver a detalles</button>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ tratamientos }}>
  const carousel = document.getElementById('carousel');
  document.getElementById('next')?.addEventListener('click', () => carousel.scrollBy({ left: 300, behavior: 'smooth' }));
  document.getElementById('prev')?.addEventListener('click', () => carousel.scrollBy({ left: -300, behavior: 'smooth' }));

  window.openModal = function(index) {
    const data = tratamientos[index];
    document.getElementById('modal-titulo').innerText = data.nombre;
    document.getElementById('modal-foto').src = data.foto;
    document.getElementById('modal-desc').innerText = data.desc;
    document.getElementById('modal-precio').innerText = data.precio;
    document.getElementById('modal-beneficios').innerHTML = data.beneficios.map(b => `<li>✓ ${b}</li>`).join('');
    document.getElementById('btn-agendar-inicio').onclick = () => showCalendar(data.calendlyLink);
    document.getElementById('modal').classList.remove('hidden');
  }

  function showCalendar(link) {
    document.getElementById('modal-info-view').classList.add('hidden');
    const calView = document.getElementById('modal-calendar-view');
    calView.classList.remove('hidden');
    calView.querySelector('#calendly-embed').innerHTML = `<iframe src="${link}" width="100%" height="100%" frameborder="0"></iframe>`;
  }

  window.resetModal = function() {
    document.getElementById('modal-info-view').classList.remove('hidden');
    document.getElementById('modal-calendar-view').classList.add('hidden');
  }

  window.closeModal = function() {
    document.getElementById('modal').classList.add('hidden');
    resetModal();
  }
</script>

<style is:global>
  .scrollbar-hide::-webkit-scrollbar { display: none; }
</style>