---
// src/components/Servicios.astro
const tratamientos = [
  {
    nombre: "Limpieza Facial Profunda",
    precio: "$1,200 MXN",
    desc: "Un tratamiento exhaustivo para eliminar impurezas y células muertas, dejando tu piel renovada y luminosa.",
    beneficios: ["Eliminación profunda de puntos negros", "Hidratación equilibrada", "Mejora la textura de la piel"],
    foto: "https://images.unsplash.com/photo-1512290923902-8a9f81dc236c?q=80&w=600&auto=format&fit=crop"
  },
  {
    nombre: "Microdermoabrasión",
    precio: "$1,500 MXN",
    desc: "Técnica de exfoliación mecánica que estimula la producción de colágeno y rejuvenece el rostro.",
    beneficios: ["Reduce líneas de expresión", "Atenúa manchas solares", "Efecto piel de porcelana"],
    foto: "https://images.unsplash.com/photo-1560750588-73207b1ef5b8?q=80&w=600&auto=format&fit=crop"
  },
  {
    nombre: "Peeling Químico",
    precio: "$1,800 MXN",
    desc: "Renovación celular profunda mediante activos químicos profesionales para un tono unificado.",
    beneficios: ["Elimina células muertas", "Control de brotes de acné", "Unifica el tono facial"],
    foto: "https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?q=80&w=600&auto=format&fit=crop"
  }
];

const telefonoWhatsApp = "523151195149";
---

<section id="servicios" class="py-24 bg-[#fdfdfc]">
  <div class="max-w-6xl mx-auto px-6">
    <div class="mb-16 text-center">
      <h2 class="text-3xl md:text-5xl font-serif text-stone-900">Nuestros Tratamientos</h2>
      <div class="w-12 h-0.5 bg-[#556b2f] mx-auto mt-6"></div>
    </div>

    <div class="flex gap-8 overflow-x-auto pb-8 snap-x snap-mandatory scrollbar-hide">
      {tratamientos.map((item, i) => (
        <div class="min-w-[280px] md:min-w-[350px] snap-start flex flex-col bg-white rounded-2xl border border-stone-100 shadow-sm hover:shadow-xl transition-all duration-500 overflow-hidden group">
          <img src={item.foto} alt={item.nombre} class="w-full h-64 object-cover transition-transform duration-700 group-hover:scale-105" />
          <div class="p-8 flex flex-col flex-grow">
            <h3 class="text-xl font-medium text-stone-900 mb-2">{item.nombre}</h3>
            <p class="text-[#556b2f] font-semibold mb-4">{item.precio}</p>
            <p class="text-stone-500 text-sm leading-relaxed mb-6 flex-grow">{item.desc}</p>
            <button 
              onclick={`openModal(${i})`}
              class="w-full py-4 border border-stone-900 text-stone-900 hover:bg-stone-900 hover:text-white transition-all uppercase text-[10px] tracking-widest font-bold"
            >
              Conocer más
            </button>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<div id="modal" class="fixed inset-0 z-[100] hidden items-center justify-center p-4">
  <div class="absolute inset-0 bg-stone-900/40 backdrop-blur-sm" onclick="closeModal()"></div>
  <div class="bg-white w-full max-w-md rounded-2xl shadow-2xl relative animate-in fade-in zoom-in duration-300">
    <button onclick="closeModal()" class="absolute top-4 right-4 text-stone-400 hover:text-stone-900 z-10">✕</button>
    <div class="p-8">
      <h3 id="modal-titulo" class="text-2xl font-serif mb-2"></h3>
      <p id="modal-desc" class="text-stone-500 text-sm mb-6"></p>
      <ul id="modal-beneficios" class="space-y-2 text-stone-600 mb-8 text-sm"></ul>
      
      <button 
        id="btn-whatsapp"
        class="w-full py-4 bg-[#556b2f] text-white uppercase text-[10px] tracking-widest font-bold hover:bg-[#3b4d1f] transition-all rounded-full shadow-lg"
      >
        Agendar por WhatsApp
      </button>
    </div>
  </div>
</div>

<script define:vars={{ tratamientos, telefonoWhatsApp }}>
  const modal = document.getElementById('modal');

  window.openModal = (i) => {
    const data = tratamientos[i];
    document.getElementById('modal-titulo').innerText = data.nombre;
    document.getElementById('modal-desc').innerText = data.desc;
    document.getElementById('modal-beneficios').innerHTML = data.beneficios.map(b => `<li>• ${b}</li>`).join('');
    
    const mensaje = `¡Hola! Me interesa agendar una cita para el tratamiento: *${data.nombre}*. ¿Tienen disponibilidad?`;
    const link = `https://wa.me/${telefonoWhatsApp}?text=${encodeURIComponent(mensaje)}`;
    
    document.getElementById('btn-whatsapp').onclick = () => window.open(link, '_blank');
    modal.classList.replace('hidden', 'flex');
  };

  window.closeModal = () => modal.classList.replace('flex', 'hidden');
</script>

<style>
  .scrollbar-hide::-webkit-scrollbar { display: none; }
</style>