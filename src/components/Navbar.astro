---
// src/components/Navbar.astro
---
<header class="sticky top-0 z-50 w-full border-b border-stone-200/60 bg-white/80 backdrop-blur-md">
  <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
    
    <a href="#" class="text-xs font-semibold tracking-widest text-stone-900 flex items-center gap-2 uppercase">
      <span class="w-2 h-2 rounded-full bg-amber-400/90 shadow-[0_0_8px_rgba(217,119,6,0.4)]"></span>
      LEO ALMADA VIDRIO
    </a>

    <nav class="hidden md:flex items-center space-x-8 text-xs font-semibold tracking-widest text-stone-500">
      <a href="#" style="--hover-color: #556b2f;" class="hover:text-[var(--hover-color)] transition-colors">INICIO</a>
      <a href="#servicios" style="--hover-color: #556b2f;" class="hover:text-[var(--hover-color)] transition-colors">TRATAMIENTOS</a>
      <a href="#galeria" style="--hover-color: #556b2f;" class="hover:text-[var(--hover-color)] transition-colors">NUESTRA CABINA</a>
      <a href="#resultados" style="--hover-color: #556b2f;" class="hover:text-[var(--hover-color)] transition-colors">RESULTADOS</a>
    </nav>

    <a 
      href="#agenda" 
      class="text-[11px] font-semibold tracking-widest uppercase border px-5 py-2 rounded-full transition-all duration-300 text-center"
      style="border-color: rgba(212, 175, 55, 0.4); color: #556b2f; background-color: rgba(255, 255, 255, 0.5);"
      onmouseover="this.style.backgroundColor='#556b2f'; this.style.textColor='#ffffff'; this.style.color='#ffffff';"
      onmouseout="this.style.backgroundColor='rgba(255, 255, 255, 0.5)'; this.style.color='#556b2f';"
    >
      Agendar Cita
    </a>
  </div>
</header>