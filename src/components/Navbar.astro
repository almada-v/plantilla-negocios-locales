---
// src/components/Navbar.astro
// import { Image } from 'astro:assets';
// import logoEmpresa from '../assets/logo.png'; // Descomenta si usas una imagen de logo

const telefono = "523151195149"; 
const mensajeTexto = "¡Hola! Me gustaría agendar una cita";
const linkWhatsApp = `https://wa.me/${telefono}?text=${encodeURIComponent(mensajeTexto)}`;
---

<!-- HEADER PRINCIPAL -->
<header id="navbar" class="fixed top-0 left-0 w-full z-50 h-20 bg-transparent transition-all duration-300 ease-in-out select-none">
  <div class="max-w-6xl mx-auto px-6 h-full flex items-center justify-between">
    
    <!-- Contenedor del Logo (Espacio limpio para texto o imagen de empresa) -->
    <a href="/" class="text-xs font-bold tracking-[0.2em] text-stone-900 uppercase flex items-center h-full [webkit-tap-highlight-color:transparent]">
      <!-- <Image src={logoEmpresa} alt="Logo de la empresa" class="h-8 w-auto object-contain" /> -->
      COMPAÑIA
    </a>

    <!-- Menú de Escritorio (Oculto en móviles) -->
    <nav class="hidden md:flex items-center space-x-10 text-[10px] font-bold tracking-[0.3em] text-stone-500 uppercase">
      <a href="/" class="hover:text-[#556b2f] transition-all duration-300">Inicio</a>
      <a href="#servicios" class="hover:text-[#556b2f] transition-all duration-300">Tratamientos</a>
      <a href="#galeria" class="hover:text-[#556b2f] transition-all duration-300">Nosotros</a>
      <a href="#ubicacion" class="hover:text-[#556b2f] transition-all duration-300">Ubicación</a>
      <a href="#faq" class="hover:text-[#556b2f] transition-all duration-300">¿Dudas?</a>
    </nav>

    <!-- Botón de WhatsApp + Disparador del Menú Móvil -->
    <div class="flex items-center gap-4">
      <a 
        href={linkWhatsApp} 
        id="btn-nav-whatsapp"
        class="px-5 py-2.5 text-[10px] font-bold tracking-[0.2em] uppercase border border-[#556b2f]/30 text-[#556b2f] rounded-full bg-white/50 backdrop-blur-sm transition-all duration-75 active:bg-[#556b2f] active:text-white touch-manipulation [webkit-tap-highlight-color:transparent]"
      >
        Agendar Cita
      </a>

      <!-- Icono Hamburguesa Independiente -->
      <button 
        id="menu-toggle"
        class="flex flex-col justify-center items-center w-8 h-8 gap-1.5 md:hidden text-stone-900 focus:outline-none touch-manipulation [webkit-tap-highlight-color:transparent]"
        aria-label="Abrir menú de navegación"
      >
        <span class="w-5 h-0.5 bg-current rounded-full transition-all duration-300 linea-1"></span>
        <span class="w-5 h-0.5 bg-current rounded-full transition-all duration-300 linea-2"></span>
      </button>
    </div>
  </div>
</header>

<!-- MENÚ MÓVIL (Separado del header para corregir el bug de responsividad en scroll) -->
<div 
  id="mobile-menu" 
  class="fixed inset-0 bg-[#fdfdfc]/98 backdrop-blur-xl z-[40] flex flex-col justify-center items-center transition-all duration-300 ease-in-out opacity-0 pointer-events-none -translate-y-4 md:hidden"
>
  <nav class="flex flex-col items-center space-y-8 text-xs font-bold tracking-[0.4em] text-stone-500 uppercase">
    <a href="/" class="link-movil text-stone-900 active:text-[#556b2f] transition-colors">Inicio</a>
    <a href="#servicios" class="link-movil active:text-[#556b2f] transition-colors">Tratamientos</a>
    <a href="#galeria" class="link-movil active:text-[#556b2f] transition-colors">Nosotros</a>
    <a href="#ubicacion" class="link-movil active:text-[#556b2f] transition-colors">Ubicación</a>
    <a href="#faq" class="link-movil active:text-[#556b2f] transition-colors">¿Dudas?</a>
  </nav>
</div>

<script>
  const navbar = document.getElementById('navbar');
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const linksMovil = document.querySelectorAll('.link-movil');
  const btnWhatsapp = document.getElementById('btn-nav-whatsapp');

  // 1. CONTROL DE SCROLL (Cambia el fondo y reduce la altura del header global)
  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      navbar?.classList.replace('h-20', 'h-14');
      navbar?.classList.add('bg-white/80', 'backdrop-blur-md', 'shadow-[0_2px_20px_rgba(0,0,0,0.02)]');
    } else {
      navbar?.classList.replace('h-14', 'h-20');
      navbar?.classList.remove('bg-white/80', 'backdrop-blur-md', 'shadow-[0_2px_20px_rgba(0,0,0,0.02)]');
    }
  });

  // 2. CONTROL DEL MENÚ DESPLEGABLE MÓVIL
  const toggleMenu = () => {
    if (navigator.vibrate) navigator.vibrate(20); 

    const isOpen = mobileMenu?.classList.contains('opacity-100');

    if (isOpen) {
      // Ocultar Menú Móvil
      mobileMenu?.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
      mobileMenu?.classList.add('opacity-0', 'pointer-events-none', '-translate-y-4');
      menuToggle?.classList.remove('menu-abierto');
    } else {
      // Mostrar Menú Móvil
      mobileMenu?.classList.remove('opacity-0', 'pointer-events-none', '-translate-y-4');
      mobileMenu?.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
      menuToggle?.classList.add('menu-abierto');
    }
  };

  menuToggle?.addEventListener('click', toggleMenu);
  linksMovil.forEach(link => link.addEventListener('click', toggleMenu));

  btnWhatsapp?.addEventListener('click', () => {
    if (navigator.vibrate) navigator.vibrate(40);
  });
</script>

<style>
  /* Transformación limpia de la hamburguesa a una cruz táctil */
  .menu-abierto .linea-1 {
    transform: translateY(2px) rotate(45deg);
  }
  .menu-abierto .linea-2 {
    transform: translateY(-4px) rotate(-45deg);
  }
</style>
