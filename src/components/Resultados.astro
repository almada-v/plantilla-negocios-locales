---
// src/components/Resultados.astro
---
<section id="resultados" class="py-24 bg-slate-950 border-t border-slate-900 relative">
  <div class="max-w-4xl mx-auto px-4">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4 tracking-tight">
        Resultados y <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500">Antes & Después</span>
      </h2>
      <p class="text-slate-400 text-sm md:text-base">
        Evidencia real de la efectividad de nuestros tratamientos progresivos.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 bg-slate-900/40 p-6 rounded-3xl border border-slate-800/60 backdrop-blur-sm">
      
      <div class="relative rounded-2xl overflow-hidden border border-slate-800 aspect-[4/3] group">
        <img 
          src="https://images.unsplash.com/photo-1596755094514-f87e34085b2c?q=80&w=600&auto=format&fit=crop" 
          alt="Tratamiento de Acné Antes" 
          class="w-full h-full object-cover grayscale-[30%] group-hover:scale-105 transition-transform duration-700"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent"></div>
        <div class="absolute bottom-4 left-4 right-4 flex justify-between items-end">
          <div>
            <span class="text-xs font-bold uppercase tracking-widest text-red-400 bg-red-950/80 px-2.5 py-1 rounded-md border border-red-900/50">Antes</span>
            <p class="text-xs text-slate-300 mt-2 font-medium">Tratamiento de Acné - Sesión 1</p>
          </div>
        </div>
      </div>

      <div class="relative rounded-2xl overflow-hidden border border-cyan-500/30 aspect-[4/3] group shadow-[0_0_25px_rgba(34,211,238,0.05)]">
        <img 
          src="https://images.unsplash.com/photo-1614859324967-bdf461f07693?q=80&w=600&auto=format&fit=crop" 
          alt="Tratamiento de Acné Después" 
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent"></div>
        <div class="absolute bottom-4 left-4 right-4 flex justify-between items-end">
          <div>
            <span class="text-xs font-bold uppercase tracking-widest text-cyan-400 bg-cyan-950/80 px-2.5 py-1 rounded-md border border-cyan-900/50">Después</span>
            <p class="text-xs text-slate-300 mt-2 font-medium">Resultados tras 4 sesiones</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>