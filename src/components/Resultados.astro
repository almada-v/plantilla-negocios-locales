---
import { Image } from 'astro:assets';
import antesFoto from '../assets/antes.jpg';
import despuesFoto from '../assets/despues.jpg';
---

<div class="max-w-3xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-4 bg-white p-4 rounded-3xl border border-stone-100 shadow-sm">
  
  <div class="relative rounded-xl overflow-hidden aspect-[4/3] group">
    <Image 
      src={antesFoto} 
      alt="Piel antes del tratamiento" 
      class="w-full h-full object-cover transition-transform duration-[1.5s] ease-out group-hover:scale-105" 
    />
    <div class="absolute top-3 left-3">
      <span class="px-3 py-1 rounded-md bg-stone-900/40 backdrop-blur-sm text-[9px] font-bold uppercase tracking-widest text-white">
        Antes
      </span>
    </div>
  </div>

  <div class="relative rounded-xl overflow-hidden aspect-[4/3] group">
    <Image 
      src={despuesFoto} 
      alt="Piel después del tratamiento" 
      class="w-full h-full object-cover transition-transform duration-[1.5s] ease-out group-hover:scale-105" 
    />
    <div class="absolute top-3 left-3">
      <span class="px-3 py-1 rounded-md bg-[#556b2f]/80 backdrop-blur-sm text-[9px] font-bold uppercase tracking-widest text-white">
        Después
      </span>
    </div>
  </div>
</div>