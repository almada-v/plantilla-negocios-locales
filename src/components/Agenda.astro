---
// src/components/Agenda.astro

// Variables de configuración rápida para tu cliente
const modoGoogleCalendar = true; // ➔ CAMBIA A "true" SI EL CLIENTE PAGA LA VERSIÓN PRO
const telefonoWhatsApp = "523151195149"; // Número del negocio
---

<section
  id="contacto"
  class="w-full max-w-4xl mx-auto px-6 py-16 border-t border-slate-800"
>
  <div class="text-center mb-12">
    <h2 class="text-3xl md:text-4xl font-extrabold text-white">
      Reserva tu <span
        class="bg-gradient-to-r from-cyan-400 to-blue-500 bg-clip-text text-transparent"
        >Espacio</span
      >
    </h2>
    <p class="mt-3 text-slate-400 text-sm md:text-base max-w-md mx-auto">
      Elige la modalidad que prefieras para asegurar tu tratamiento y lucir una
      piel espectacular.
    </p>
  </div>

  <div
    class="bg-slate-800/30 backdrop-blur-sm rounded-3xl border border-slate-800 p-6 md:p-10 shadow-2xl"
  >
    {
      modoGoogleCalendar ? (
        <div class="w-full overflow-hidden rounded-2xl bg-slate-900 border border-slate-700/50 shadow-inner">
          <iframe
            src="https://calendar.app.google/vJ58zUGu1VzDXrE88"
            style="border: 0;"
            width="100%"
            height="700"
            frameborder="0"
            class="w-full min-h-[650px] md:min-h-[700px]"
          />
        </div>
        
      ) : (
        <div class="max-w-md mx-auto">
          <form id="appointment-form" class="space-y-5">
            <div>
              <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">
                Tu Nombre completo
              </label>
              <input
                type="text"
                id="form-name"
                required
                class="w-full bg-slate-900/80 border border-slate-700 rounded-xl px-4 py-3 text-white placeholder-slate-600 focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-all"
                placeholder="Ej. Ana Paula Galindo"
              />
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">
                Tratamiento que buscas
              </label>
              <select
                id="form-service"
                class="w-full bg-slate-900/80 border border-slate-700 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-cyan-500 transition-all"
              >
                <option>Limpieza Facial Profunda ($450 MXN)</option>
                <option>Hidratación con Ácido Hialurónico ($600 MXN)</option>
                <option>Tratamiento Anti-Acné ($550 MXN)</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">
                Día y Hora sugerida
              </label>
              <input
                type="datetime-local"
                id="form-date"
                required
                class="w-full bg-slate-900/80 border border-slate-700 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-cyan-500 transition-all"
              />
            </div>

            <button
              type="submit"
              class="w-full py-4 bg-gradient-to-r from-emerald-500 to-green-600 hover:from-emerald-600 hover:to-green-700 text-white font-bold rounded-xl shadow-lg transition-all duration-300 hover:scale-[1.02] flex items-center justify-center gap-2 mt-2"
            >
              Solicitar Cita por WhatsApp
            </button>
          </form>
        </div>
      )
    }
  </div>
</section>

<script define:vars={{ telefonoWhatsApp }}>
  const form = document.getElementById("appointment-form");
  if (form) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();

      const name = document.getElementById("form-name").value;
      const service = document.getElementById("form-service").value;
      const dateInput = document.getElementById("form-date").value;

      // Formatear un poco la fecha nativa para que sea leíble en el mensaje
      const fechaFormateada = dateInput.replace("T", " a las ");

      const textoMensaje = `¡Hola! Me llamo *${name}* y me gustaría agendar una cita para el servicio de *${service}* el día *${fechaFormateada}*. ¿Tienen espacio disponible?`;
      const url = `https://wa.me/${telefonoWhatsApp}?text=${encodeURIComponent(textoMensaje)}`;

      window.open(url, "_blank");
    });
  }
</script>
