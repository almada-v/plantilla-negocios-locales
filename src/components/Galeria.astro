---
// src/components/Galeria.astro
import { Image } from 'astro:assets';

// 1. IMPORTANTE: Guarda tus fotos de cabina en tu carpeta 'src/assets/' y usa estos nombres:
import fotoCabina from '../assets/peeling.webp';
import fotoTratamiento from '../assets/limpieza.avif';
import fotoProductos from '../assets/micro.avif';

const imagenes = [
  {
    srcLocal: fotoCabina,
    alt: "Cabina de Tratamiento Premium",
    titulo: "Instalaciones",
    desc: "Un santuario privado diseñado exclusivamente para tu relajación.",
    claseAltura: "h-72 md:h-[400px]" // Altura mediana equilibrada
  },
  {
    srcLocal: fotoTratamiento,
    alt: "Procedimiento de Limpieza Facial",
    titulo: "Procedimientos",
    desc: "Protocolos personalizados ejecutados por profesionales de la piel.",
    claseAltura: "h-96 md:h-[480px]" // Altura extendida para crear el efecto cascada asimétrico
  },
  {
    srcLocal: fotoProductos,
    alt: "Línea Dermocosmética de Alta Gama",
    titulo: "Línea Dermocosmética",
    desc: "Seleccionamos minuciosamente activos médicos de alta potencia.",
    claseAltura: "h-80 md:h-[440px]" // Altura variante
  }
];
---

<section id="galeria" class="py-16 md:py-24 bg-[#fdfdfc] select-none">
  <div class="max-w-6xl mx-auto px-6">
    
    <!-- Cabecera de la Sección Estilo Editorial Boutique -->
    <div class="mb-16 text-center">
      <span class="text-[10px] font-bold tracking-[0.3em] uppercase text-[#556b2f]">
        CONOCE NUESTRO ESPACIO
      </span>
      <h2 class="text-3xl md:text-5xl font-serif text-stone-900 mt-2">Nuestra Cabina</h2>
      <div class="w-12 h-0.5 bg-[#556b2f] mx-auto mt-4"></div>
    </div>

    <!-- 
      MOSAICO EN CASCADA (Pinterest / Instagram Style):
      1 columna simétrica en celulares que fluye de forma vertical sin trabar el scroll.
      3 columnas asimétricas con alturas intercaladas en iPad, Tablets y PC.
    -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-6 items-start">
      {imagenes.map((img) => (
        <div class="flex flex-col bg-white rounded-3xl border border-stone-100/60 shadow-[0_10px_30px_rgba(0,0,0,0.01)] overflow-hidden transition-all duration-300">
          
          <!-- Contenedor del archivo fotográfico con alturas variables -->
          <div class=`w-full ${img.claseAltura} overflow-hidden relative group`>
            <!-- 
              El componente <Image /> procesa tus fotos locales convirtiéndolas 
              a formatos de alta velocidad (WebP/AVIF) optimizando píxeles de forma responsiva.
            -->
            <Image 
              src={img.srcLocal} 
              alt={img.alt} 
              class="w-full h-full object-cover transition-transform duration-700 md:group-hover:scale-105 active:scale-[1.02]" 
              loading="lazy" 
            />
            <!-- Filtro de contraste suave sobre la imagen -->
            <div class="absolute inset-0 bg-black/[0.01] pointer-events-none"></div>
          </div>

          <!-- Información limpia debajo de tu foto de archivo -->
          <div class="p-6 text-left space-y-1.5 bg-white">
            <h3 class="text-[11px] font-bold tracking-wider text-[#556b2f] uppercase">
              {img.titulo}
            </h3>
            <p class="text-stone-700 text-sm leading-relaxed font-light">
              {img.desc}
            </p>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
