---
// src/components/Galeria.astro
const imagenes = [
  {
    url: "https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?q=80&w=600&auto=format&fit=crop",
    alt: "Cabina de Tratamiento Premium",
    titulo: "Instalaciones de Vanguardia",
    desc: "Un espacio diseñado para tu relajación y cuidado profesional."
  },
  {
    url: "https://images.unsplash.com/photo-1560750588-73207b1ef5b8?q=80&w=600&auto=format&fit=crop",
    alt: "Limpieza Facial Profunda",
    titulo: "Resultados Inmediatos",
    desc: "Tratamientos personalizados con tecnología de punta."
  },
  {
    url: "https://images.unsplash.com/photo-1512290923902-8a9f81dc236c?q=80&w=600&auto=format&fit=crop",
    alt: "Productos de Alta Gama",
    titulo: "Línea Dermocosmética",
    desc: "Utilizamos solo los mejores activos para proteger tu piel."
  }
];
---

<section id="galeria" class="py-24 bg-stone-50 border-t border-stone-200/60">
  <div class="max-w-4xl mx-auto px-4">
    
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-light text-stone-900 mb-4 tracking-tight">
        Nuestra <span class="font-serif italic text-transparent bg-clip-text bg-gradient-to-r from-amber-600 to-amber-700">Galería Premium</span>
      </h2>
      <p class="text-stone-500 max-w-xl mx-auto text-sm md:text-base">
        Conoce nuestras instalaciones y la calidad de los procedimientos que realizamos.
      </p>
    </div>

    <div class="relative group">
      
      <div class="overflow-hidden rounded-3xl border border-stone-200/80 bg-white shadow-xl relative aspect-[4/3] md:aspect-[16/9]">
        {imagenes.map((img, index) => (
          <div 
            data-slide={index} 
            class={`absolute inset-0 transition-opacity duration-700 ease-in-out flex flex-col justify-end ${index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}
          >
            <img src={img.url} alt={img.alt} class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-stone-950/60 via-stone-950/20 to-transparent"></div>
            
            <div class="relative p-6 md:p-10 z-20 translate-y-0 transform transition-transform duration-500">
              <span class="text-[10px] font-bold uppercase tracking-widest text-amber-500 mb-2 block">Destacado</span>
              <h3 class="text-xl md:text-2xl font-medium text-white mb-2 tracking-wide">{img.titulo}</h3>
              <p class="text-sm text-stone-200 max-w-lg font-light">{img.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <button 
        id="prev-btn" 
        class="absolute left-4 top-1/2 -translate-y-1/2 z-30 bg-white/90 hover:bg-[#556b2f] hover:text-white text-stone-700 p-3 rounded-full border border-stone-200 shadow-md transition-all opacity-0 group-hover:opacity-100 focus:opacity-100"
        aria-label="Imagen anterior"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
        </svg>
      </button>

      <button 
        id="next-btn" 
        class="absolute right-4 top-1/2 -translate-y-1/2 z-30 bg-white/90 hover:bg-[#556b2f] hover:text-white text-stone-700 p-3 rounded-full border border-stone-200 shadow-md transition-all opacity-0 group-hover:opacity-100 focus:opacity-100"
        aria-label="Siguiente imagen"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
        </svg>
      </button>

      <div class="absolute bottom-4 left-1/2 -translate-x-1/2 z-30 flex space-x-2">
        {imagenes.map((_, index) => (
          <button 
            data-dot={index} 
            class={`w-2 h-2 rounded-full transition-all duration-300 ${index === 0 ? 'bg-[#556b2f] w-5' : 'bg-stone-300/80'}`}
            aria-label={`Ir a la diapositiva ${index + 1}`}
          ></button>
        ))}
      </div>

    </div>
  </div>
</section>

<script>
  const slides = document.querySelectorAll<HTMLElement>('[data-slide]');
  const dots = document.querySelectorAll<HTMLElement>('[data-dot]');
  const prevBtn = document.getElementById('prev-btn');
  const nextBtn = document.getElementById('next-btn');
  
  let currentIndex = 0;
  const totalSlides = slides.length;

  function updateCarousel(index: number) {
    slides.forEach((slide) => {
      const slideIndex = parseInt(slide.dataset.slide || '0');
      if (slideIndex === index) {
        slide.classList.remove('opacity-0', 'z-0');
        slide.classList.add('opacity-100', 'z-10');
      } else {
        slide.classList.remove('opacity-100', 'z-10');
        slide.classList.add('opacity-0', 'z-0');
      }
    });

    dots.forEach((dot) => {
      const dotIndex = parseInt(dot.dataset.dot || '0');
      if (dotIndex === index) {
        dot.classList.remove('bg-stone-300/80');
        dot.classList.add('bg-[#556b2f]', 'w-5');
      } else {
        dot.classList.remove('bg-[#556b2f]', 'w-5');
        dot.classList.add('bg-stone-300/80');
      }
    });
  }

  function nextSlide() {
    currentIndex = (currentIndex + 1) % totalSlides;
    updateCarousel(currentIndex);
  }

  function prevSlide() {
    currentIndex = (currentIndex - 1 + totalSlides) % totalSlides;
    updateCarousel(currentIndex);
  }

  nextBtn?.addEventListener('click', nextSlide);
  prevBtn?.addEventListener('click', prevSlide);

  dots.forEach((dot) => {
    dot.addEventListener('click', () => {
      currentIndex = parseInt(dot.dataset.dot || '0');
      updateCarousel(currentIndex);
    });
  });

  setInterval(nextSlide, 5000);
</script>